# ── LLM Provider ─────────────────────────────────────────────
LLM_PROVIDER=gemini
LLM_API_KEY=your-gemini-api-key-here
LLM_MODEL=gemini-2.0-flash

# ── Server ───────────────────────────────────────────────────
SERVER_HOST=0.0.0.0
SERVER_PORT=8000

# ── CORS (comma-separated origins) ──────────────────────────
# In production, set to your extension's origin:
#   chrome-extension://YOUR_EXTENSION_ID
CORS_ORIGINS=*
